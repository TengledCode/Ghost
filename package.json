{
  "name": "ghost",
  "productName": "Ghost",
  "version": "0.1.0",
  "description": "Ghost: a floating personal AI companion powered by your own Claude / Gemini subscription CLIs.",
  "author": "Aaron",
  "license": "UNLICENSED",
  "private": true,
  "main": "out/main/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist:win": "electron-vite build && node scripts/write-build-info.mjs && node scripts/clear-old-installers.mjs && electron-builder --win nsis",
    "preview:ui": "node scripts/preview-server.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "msedge-tts": "^2.0.8",
    "three": "^0.186.1",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "koffi": "^2.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.5.13",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
